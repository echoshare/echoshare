# Base URL of the tRPC/HTTP API (signaling server). Baked in at build time.
VITE_SERVER_URL=http://localhost:3000

# Base URL of the PeerJS signaling server, parsed into host/port/path.
# In production this must be the HTTPS origin of your self-hosted server,
# e.g. https://signal.example.com/  (WebRTC requires a secure context / WSS).
#
# Leave blank (or set https://0.peerjs.com/) to use the public PeerJS cloud.
# If a self-hosted server is set here but is unreachable, the client
# automatically fails over to the public cloud.
VITE_SIGNALING_URL=http://localhost:3000/
