# Origin of the web app (used for CORS on the tRPC + PeerJS HTTP endpoints).
# In production set this to your deployed web origin, e.g. https://echoshare.vercel.app
CORS_ORIGIN=http://localhost:3001

# Port the signaling server listens on.
PORT=3000

# Shared key PeerJS clients must present (?key=). Keep in sync with the web app.
PEER_KEY=peerjs

# Expose GET /peerjs/peers (peer discovery). Off by default — room ids are sensitive.
ALLOW_DISCOVERY=false

# Optional JSON array of ICE servers advertised to clients via signaling.config.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
ICE_SERVERS=
